# Runtime CMS Cutover Switch
# "true" -> Read live canonical portfolio from Sanity CMS via adapter
# "false" (or unset) -> Fallback to local canonical dataset (src/lib/data.ts)
ENABLE_SANITY_CMS="true"

# Public Sanity Studio Configuration (Client-side accessible)
NEXT_PUBLIC_SANITY_PROJECT_ID="your-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2024-10-01"

# Server-Side Only Secrets (Never expose to browser)
# Required for Next.js Draft Mode preview queries against unpublished drafts:
SANITY_API_READ_TOKEN=""

# Required for on-demand ISR revalidation webhooks (/api/revalidate):
SANITY_REVALIDATE_SECRET=""

# Required for activating Draft Mode preview URL (/api/draft-mode/enable):
SANITY_PREVIEW_SECRET=""
